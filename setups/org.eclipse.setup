<?xml version="1.0" encoding="UTF-8"?>
<setup:Index
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:p2="http://www.eclipse.org/oomph/p2/1.0"
    xmlns:setup="http://www.eclipse.org/oomph/setup/1.0"
    name="Eclipse">
  <annotation
      source="http://www.eclipse.org/oomph/setup/BrandingInfo">
    <detail
        key="notificationURI">
      <value>https://www.eclipse.org/sponsor/ide/?scope=${scope}&amp;version=${scope.version}&amp;campaign=2026-03</value>
    </detail>
  </annotation>
  <annotation
      source="http://www.eclipse.org/oomph/setup/Problem">
    <detail
        key="uri">
      <value>https://www.eclipse.org/setups/problems/</value>
    </detail>
    <content
        xsi:type="p2:Requirement"
        name="org.eclipse.epp.package.common"
        versionRange="4.36.0"/>
  </annotation>
  <annotation
      source="http://www.eclipse.org/oomph/setup/Problem">
    <detail
        key="uri">
      <value>https://www.eclipse.org/setups/problems/</value>
    </detail>
    <content
        xsi:type="p2:Requirement"
        name="org.eclipse.sdk.ide"
        versionRange="4.36.0"/>
  </annotation>
  <annotation
      source="http://www.eclipse.org/oomph/setup/Notification-X">
    <detail
        key="maximize">
      <value>false</value>
    </detail>
    <detail
        key="uri">
      <value>https://www.eclipse.org/setups/notification/java27/</value>
    </detail>
    <content
        xsi:type="p2:Requirement"
        name="org.eclipse.jdt.javanextpatch.feature.group"
        versionRange="[1.27.0,1.28.0)"
        optional="true"
        max="0"/>
    <content
        xsi:type="p2:Requirement"
        name="org.eclipse.jdt.feature.group"
        versionRange="[3.20.700.v20260820-0719,3.20.799]"/>
  </annotation>
  <annotation
      source="http://www.eclipse.org/oomph/setup/Notification-X">
    <detail
        key="uri">
      <value>https://www.eclipse.org/setups/notification/java27/?jre-only=true</value>
    </detail>
    <detail
        key="maximize">
      <value>false</value>
    </detail>
    <content
        xsi:type="p2:Requirement"
        name="org.eclipse.jdt.javanextpatch.feature.group"
        versionRange="[1.27.0,1.28.0)"/>
    <content
        xsi:type="p2:Requirement"
        name="installed.jre"
        versionRange="27.0.0"
        optional="true"
        max="0"/>
  </annotation>
  <annotation
      source="http://www.eclipse.org/oomph/setup/Notification-X">
    <detail
        key="description">
      <value>Offer to update to the latest milestone, if we have don't have it installed and have 2026-06 along with EPP JustJ installed, but is broken with older self-product catalog, so ensure the fix is installed too.</value>
    </detail>
    <detail
        key="maximize">
      <value>false</value>
    </detail>
    <detail
        key="uri">
      <value>https://www.eclipse.org/setups/notification/milestone</value>
    </detail>
    <content
        xsi:type="p2:Requirement"
        name="org.eclipse.epp.package.common"
        versionRange="[4.40.0,4.41.0.20260827-0616)"/>
    <content
        xsi:type="p2:Requirement"
        name="org.eclipse.justj.openjdk.hotspot.jre.full"/>
    <content
        xsi:type="p2:Requirement"
        name="org.eclipse.oomph.setup.core"
        versionRange="1.37.0.v20260720-1056"/>
  </annotation>
  <annotation
      source="http://www.eclipse.org/oomph/setup/Notification-X">
    <detail
        key="description">
      <value>Offer to update to the latest milestone, if we have don't have it installed and have 2026-06 along with a Java 25 JRE installed.</value>
    </detail>
    <detail
        key="maximize">
      <value>false</value>
    </detail>
    <detail
        key="uri">
      <value>https://www.eclipse.org/setups/notification/milestone</value>
    </detail>
    <content
        xsi:type="p2:Requirement"
        name="org.eclipse.epp.package.common"
        versionRange="[4.40.0,4.41.0.20260827-0616)"/>
    <content
        xsi:type="p2:Requirement"
        name="jre"
        versionRange="25.0.0"/>
  </annotation>
  <annotation
      source="http://www.eclipse.org/oomph/setup/Notification">
    <detail
        key="description">
      <value>Offer to update to the latest release, if we currently have 2026-06 installed, but this time only Java 25 is being used</value>
    </detail>
    <detail
        key="maximize">
      <value>false</value>
    </detail>
    <detail
        key="uri">
      <value>https://www.eclipse.org/setups/notification/release/</value>
    </detail>
    <content
        xsi:type="p2:Requirement"
        name="org.eclipse.epp.package.common"
        versionRange="[4.40.0,4.41.0.20260903-0719)"/>
    <content
        xsi:type="p2:Requirement"
        name="jre"
        versionRange="25.0.0"/>
  </annotation>
  <annotation
      source="http://www.eclipse.org/oomph/setup/Notification">
    <detail
        key="description">
      <value>Strongly encourage to sponsor the Eclipse IDE</value>
    </detail>
    <detail
        key="maximize">
      <value>true</value>
    </detail>
    <detail
        key="uri">
      <value>https://www.eclipse.org/setups/notification/sponsor/</value>
    </detail>
    <content
        xsi:type="p2:Requirement"
        name="org.eclipse.epp.package.common"
        versionRange="[4.40.0.20260604-0652,5.0.0)"/>
  </annotation>
  <annotation
      source="http://www.eclipse.org/oomph/setup/Notification-X">
    <detail
        key="description">
      <value>Offer to upgrade the 2026-06 IDE to run with Java 25, but only if a JustJ JRE is not installed and if the IDE is currently running on &lt; Java 25</value>
    </detail>
    <detail
        key="maximize">
      <value>false</value>
    </detail>
    <detail
        key="uri">
      <value>https://www.eclipse.org/setups/notification/upgrade/</value>
    </detail>
    <content
        xsi:type="p2:Requirement"
        name="org.eclipse.epp.package.common"
        versionRange="[4.40.0.20260604-0652,5.0.0)"/>
    <content
        xsi:type="p2:Requirement"
        name="jre"
        versionRange="[1.0.0.0,25.0.0)"/>
    <content
        xsi:type="p2:Requirement"
        name="org.eclipse.justj.openjdk.hotspot.jre.minimal"
        optional="true"
        max="0"/>
    <content
        xsi:type="p2:Requirement"
        name="org.eclipse.justj.openjdk.hotspot.jre.minimal.stripped"
        optional="true"
        max="0"/>
    <content
        xsi:type="p2:Requirement"
        name="org.eclipse.justj.openjdk.hotspot.jre.full"
        optional="true"
        max="0"/>
    <content
        xsi:type="p2:Requirement"
        name="org.eclipse.justj.openjdk.hotspot.jre.full.stripped"
        optional="true"
        max="0"/>
  </annotation>
  <annotation
      source="http://www.eclipse.org/oomph/setup/JRE">
    <reference
        href="org.eclipse.jres.setup#/"/>
  </annotation>
  <annotation
      source="http://www.eclipse.org/oomph/setup/TrustedKeys">
    <detail
        key="filter">
      <value>(&amp;(|(eclipse.product=org.eclipse.oomph.setup.installer.product)(eclipse.product=org.eclipse.epp.package.*)(eclipse.product=org.eclipse.sdk.ide)(eclipse.product=org.eclipse.platform.ide)(org.eclipse.oomph.setup.trust.keys=true))(!(org.eclipse.oomph.setup.trust.keys=false)))</value>
    </detail>
    <reference
        href="keys/trusted-keys.asc#/"/>
  </annotation>
  <discoverablePackage
      href="models/Git.ecore#/"/>
